# API Keys
QWEN_API_KEY=your_qwen_api_key_here
GRSAI_API_KEY=your_grsai_api_key_here

# API Base URLs
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
GRSAI_API_BASE=https://grsai.dakka.com.cn

# Application Settings
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS Settings (前端地址)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Generation Settings
DEFAULT_IMAGE_WIDTH=1344
DEFAULT_IMAGE_HEIGHT=768
DEFAULT_STEPS=20
DEFAULT_CFG_SCALE=7.5
MAX_STEPS_COUNT=6

# GRSAI Nano Banana Settings
GRSAI_MODEL=nano-banana-pro
GRSAI_IMAGE_SIZE=1K
GRSAI_ASPECT_RATIO=auto
GRSAI_POLL_INTERVAL=2
GRSAI_MAX_POLL_ATTEMPTS=60
